{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Avijit-Kumar-GIT/fella-extensions/catalog.schema.json",
  "title": "catalog.json",
  "description": "The marketplace index. Generated by scripts/build-catalog.mjs; the Fella app reads only packs[].id and packs[].files[].{path,url,sha256}. Every other field feeds the browse site.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "base", "packs"],
  "properties": {
    "schema": { "const": 1 },
    "_comment": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "base": { "type": "string", "format": "uri" },
    "packs": {
      "type": "array",
      "items": { "$ref": "#/$defs/pack" }
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "version",
        "description",
        "author",
        "license",
        "homepage",
        "published",
        "updated",
        "size_bytes",
        "installs",
        "readme_html",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "kind": { "enum": ["theme", "skill", "mcp"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string", "maxLength": 100 },
        "license": { "type": "string", "maxLength": 40 },
        "homepage": { "type": "string", "format": "uri" },
        "published": { "type": ["string", "null"], "format": "date-time" },
        "updated": { "type": ["string", "null"], "format": "date-time" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "installs": { "type": ["integer", "null"], "minimum": 0 },
        "readme_html": { "type": "string" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "url", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^[^/][^\\\\:]*$" },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
